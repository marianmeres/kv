{
  "name": "@marianmeres/kv",
  "version": "3.1.1",
  "description": "Key-value storage abstraction with a unified, Redis-inspired API over memory, Redis, PostgreSQL and SQLite backends.",
  "license": "MIT",
  "author": "Marian Meres",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "API.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianmeres/kv.git"
  },
  "bugs": {
    "url": "https://github.com/marianmeres/kv/issues"
  },
  "homepage": "https://github.com/marianmeres/kv#readme",
  "keywords": [
    "kv",
    "key-value",
    "redis",
    "postgres",
    "postgresql",
    "sqlite",
    "cache",
    "ttl",
    "storage"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test --env-file-if-exists=.env \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch --env-file-if-exists=.env \"tests/**/*.test.ts\"",
    "test:deno": "deno test -A --no-check --env-file tests/",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test",
    "prepublishOnly": "pnpm run ci && pnpm run build",
    "jsr:check": "deno publish --dry-run --allow-dirty --no-check --set-version \"$npm_package_version\"",
    "release": "npx --yes @marianmeres/release@^2.2.0",
    "publish:jsr": "pnpm run test:deno && deno publish --no-check --set-version \"$npm_package_version\"",
    "publish:all": "pnpm publish && pnpm run publish:jsr",
    "rp": "pnpm run release -y && pnpm run publish:all",
    "rpm": "pnpm run release minor -y && pnpm run publish:all"
  },
  "dependencies": {
    "@marianmeres/clog": "^3.23.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
